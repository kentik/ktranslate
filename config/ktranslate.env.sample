## ENV VARS to set for ktranslate

## This is added to ktranslate service as any extra flags to set.
KT_FLAGS=""

## NR Specific settings.
NR_ACCOUNT_ID=""
NR_REGION=""
NEW_RELIC_API_KEY=""

### For SNMP:
# KT_FLAGS="-snmp /etc/ktranslate/snmp.yaml nr1.snmp"
#

### For Netflow:
# KT_FLAGS="-nf.source ipfix nr1.flow"
#

### To stamp custom attributes (e.g. an install/instance identifier) onto every
### metric batch sent to New Relic:
# KT_FLAGS="-nr_custom_attributes install_id=abc123,env=prod"
#